BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=change-me

BOOTSTRAP_IN_CAMERA_ID=11111111-1111-1111-1111-111111111111
BOOTSTRAP_OUT_CAMERA_ID=22222222-2222-2222-2222-222222222222

# Set one of the bootstrap camera IDs per camera deployment.
CAMERA_ID=11111111-1111-1111-1111-111111111111

FACE_MATCH_THRESHOLD=0.5
DUPLICATE_WINDOW_SECONDS=60

# Example Production tuning
# DET_SIZE=640
# INTRA_OP_NUM_THREADS=4
# INTER_OP_NUM_THREADS=1
# STREAM_EXECUTOR_WORKERS=4
# SAMPLE_EVERY_N=10
# MAX_ACTIVE_TRACKS=10
# TARGET_FPS=25
# LOG_FRAME_TIMING=0
# LOG_FRAME_TIMING=0

